# Application Environment
APP_ENV=development
APP_SECRET_KEY=insecure-dev-secret-key-change-in-production-32b

# Database Connection URLs
# Runtime async engine (compatible with NullPool / Transaction Pooler on port 6543, or local direct on 5432)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_platform
# Direct session-mode connection for Alembic migrations (port 5432)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_platform

# Supabase Auth Configuration
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key-backend-only
# Optional local/test secret only (strictly forbidden in production)
SUPABASE_JWT_SECRET=

# LLM BYOK Master Encryption Key (32-byte hex for AES-256-GCM)
LLM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
